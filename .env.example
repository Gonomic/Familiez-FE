# Synology SSO Configuration
VITE_SYNOLOGY_AUTH_URL=https://your-synology-domain
VITE_CLIENT_ID=your-client-id
VITE_REDIRECT_URI=http://your-domain:5173/auth/callback
VITE_SYNOLOGY_DISCOVERY_URL=https://your-synology-domain/webman/sso/.well-known/openid-configuration

# Optional second OAuth client (used automatically when browser origin matches VITE_REDIRECT_URI_LOCAL)
VITE_CLIENT_ID_LOCAL=
VITE_REDIRECT_URI_LOCAL=
# Optional overrides for local client (fallback to primary values when empty)
VITE_SYNOLOGY_AUTH_URL_LOCAL=
VITE_SYNOLOGY_DISCOVERY_URL_LOCAL=
VITE_API_BASE_LOCAL=

# API Configuration
VITE_API_BASE=http://localhost:8000
